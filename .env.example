NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Bearer secret for /api/cron/detect (Vercel Cron sends it automatically)
CRON_SECRET=
# Needed for "Retry supplier submission" on an order (storefront base URL + its CJ_FULFILLMENT_SECRET)
STOREFRONT_URL=
CJ_FULFILLMENT_SECRET=
# Needed for refunds. Use a RESTRICTED Stripe key (Refunds: write, Checkout Sessions: read).
STRIPE_SECRET_KEY=
